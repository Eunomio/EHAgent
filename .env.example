EH_BIND_HOST=0.0.0.0
EH_PORT=8000
EH_DATABASE_PATH=runtime/ehagent.db
EH_EVIDENCE_ROOT=evidence

# 萤石开放平台应用凭证只保存在后端电脑，APK不填写这些内容
EH_EZVIZ_APP_KEY=
EH_EZVIZ_APP_SECRET=
EH_EZVIZ_ACCESS_TOKEN=
EH_EZVIZ_AUTO_TOKEN=true
EH_EZVIZ_DEVICE_SERIAL=
EH_EZVIZ_CHANNEL_NO=1
EH_EZVIZ_VERIFY_CODE=
# 优先轮询萤石移动告警；8秒未触发时使用图片差异检测兜底
EH_EZVIZ_ALARM_DETECTION_ENABLED=true
EH_EZVIZ_ALARM_POLL_SECONDS=2
EH_EZVIZ_ALARM_TIMEOUT_SECONDS=2
EH_EZVIZ_ALARM_SETTLE_SECONDS=1
EH_EZVIZ_ALARM_FALLBACK_SECONDS=8

# disabled / ezviz / webhook / authorized_export
EH_SLEEP_PROVIDER=disabled
EH_SLEEP_DEVICE_NAME=萤石无感睡眠伴侣
EH_SLEEP_DEVICE_SERIAL=
EH_SLEEP_DEVICE_ID=
# 萤石睡眠时间字符串的UTC偏移；当前设备统计按UTC验证，若厂商确认本地时区再调整。
EH_SLEEP_TIMESTAMP_UTC_OFFSET_HOURS=0
# 每日同步使用北京时间10:00，并在后端启动时补拉最近3天
EH_SLEEP_AUTO_SYNC_ENABLED=true
EH_SLEEP_SYNC_HOUR=10
EH_SLEEP_SYNC_MINUTE=0
EH_SLEEP_SYNC_LOOKBACK_DAYS=3
EH_SLEEP_SYNC_UTC_OFFSET_HOURS=8
EH_SAFETY_AREA_NAME=卧室外走道

# LLM只负责解释和整理文案；关闭或调用失败时自动使用固定模板
EH_LLM_ENABLED=false
EH_LLM_PROVIDER=openai
EH_LLM_API_KEY=
EH_LLM_MODEL=gpt-5.4-nano
EH_LLM_API_BASE=https://api.openai.com/v1
EH_LLM_TIMEOUT_SECONDS=15
EH_LLM_MAX_OUTPUT_TOKENS=500

# 通道图片分析。留空的密钥和地址会沿用上面的LLM配置。
# 未填写EH_VLM_ENABLED时，也会沿用EH_LLM_ENABLED，方便继续使用现有试验配置。
EH_VLM_ENABLED=false
EH_VLM_API_KEY=
EH_VLM_MODEL=ecnu-plus
EH_VLM_API_BASE=
EH_VLM_TIMEOUT_SECONDS=60
EH_VLM_AUTO_CHECK_ENABLED=true
# 本地兜底每1秒确认一次；变化连续出现2次后进行安全检查
EH_VLM_CHANGE_POLL_SECONDS=1
EH_VLM_CHANGE_THRESHOLD=0.025
EH_VLM_CHANGE_CONFIRMATIONS=2
EH_VLM_CHANGE_COOLDOWN_SECONDS=10
EH_VLM_IMAGE_MAX_DIMENSION=1280
EH_VLM_IMAGE_JPEG_QUALITY=85
# 红色风险语音提示，沿用VLM或LLM的地址和密钥
EH_TTS_ENABLED=true
EH_TTS_MODEL=ecnu-tts
EH_TTS_VOICE=liwa
EH_TTS_SPEED=0.9
EH_ASSISTANT_WEB_SEARCH_ENABLED=true
EH_ASSISTANT_LOCATION=

# 老人端语音输入。使用兼容 OpenAI /audio/transcriptions 的服务。
# ChatECNU 当前模型列表不含ASR模型，需要单独填写语音识别服务地址与密钥。
EH_ASR_ENABLED=false
EH_ASR_API_KEY=
EH_ASR_MODEL=whisper-1
EH_ASR_API_BASE=https://api.openai.com/v1
EH_ASR_LANGUAGE=zh
EH_ASR_TIMEOUT_SECONDS=60
