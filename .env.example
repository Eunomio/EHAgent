EHAGENT_APP_NAME=居安Agent
EHAGENT_APP_ENV=development
EHAGENT_APP_TIMEZONE=Asia/Shanghai
EHAGENT_BIND_HOST=127.0.0.1
EHAGENT_PORT=8000
EHAGENT_DATABASE_URL=sqlite:///./runtime/ehagent.db
EHAGENT_LOG_LEVEL=INFO
EHAGENT_ENGINEERING_API_KEY=replace-with-a-long-random-value
EHAGENT_CAMERA_PROVIDER=replay
EHAGENT_REPLAY_ROOT=./tests/fixtures/replay

